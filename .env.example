# Set these in the hosting service environment. server.py does not load .env files.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
INQUIRY_FROM=
INQUIRY_TO=
INQUIRY_ORIGINS=https://augment-wh.com,https://www.augment-wh.com

# Legacy SMTP fallback, used only when no GRAPH_* variables are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
PORT=8091

# Vercel-only analytics dashboard; set in the Vercel project and redeploy.
ANALYTICS_VERCEL_TOKEN=
ANALYTICS_PROJECT_ID=
ANALYTICS_TEAM_ID=

# Vercel admin login. Set ADMIN_PIN to the chosen PIN, and use a random 32+ character secret.
ADMIN_PIN=
ADMIN_SESSION_SECRET=
